# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/geolinkVault?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=development

# ACLED API (register free at https://acleddata.com/register/)
ACLED_API_KEY=your_acled_api_key_here
ACLED_EMAIL=your_email@example.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
